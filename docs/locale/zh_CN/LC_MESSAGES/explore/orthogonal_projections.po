msgstr "是"

#: ../../source/explore/orthogonal_projections.rst:89
msgid "Original formulation; can behave differently under non-linearities."
msgstr "原始形式；在存在非线性时可能表现不同。"

#: ../../source/explore/orthogonal_projections.rst:90
msgid "OSC (sjoblom)"
msgstr "OSC（sjoblom）"

#: ../../source/explore/orthogonal_projections.rst:93
msgid "Modified iteration; often converges faster than ``\"wold\"``."
msgstr "改进的迭代方式；通常比 ``\"wold\"`` 收敛得更快。"

#: ../../source/explore/orthogonal_projections.rst:94
