msgid "**Fitting PDS**"
msgstr "**拟合 PDS**"

#: ../../source/explore/calibration_transfer.rst:142
msgid "**Applying PDS**"
msgstr "**应用 PDS**"

#: ../../source/explore/calibration_transfer.rst:149
msgid "Choosing between DS and PDS"
msgstr "在 DS 和 PDS 之间进行选择"

