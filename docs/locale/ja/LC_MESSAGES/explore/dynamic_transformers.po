msgstr "積分時間または希釈係数"

#: ../../source/explore/dynamic_transformers.rst:441
msgid "``(n_samples, n_features)``"
msgstr "``(n_samples, n_features)``"

#: ../../source/explore/dynamic_transformers.rst:442
