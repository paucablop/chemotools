#: ../../source/explore/orthogonal_projections.rst:97
msgid "Direct, non-iterative; deterministic and fast."
msgstr "直接的な非反復法。決定論的で高速です。"

#: ../../source/explore/orthogonal_projections.rst:98
msgid "OPLS"
msgstr "OPLS"

#: ../../source/explore/orthogonal_projections.rst:99
