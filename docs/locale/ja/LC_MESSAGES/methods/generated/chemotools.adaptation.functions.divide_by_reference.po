#: ../../source/methods/generated/chemotools.adaptation.functions.divide_by_reference.rst:2
msgid "chemotools.adaptation.functions.divide\\_by\\_reference"
msgstr "chemotools.adaptation.functions.divide\\_by\\_reference"

#: chemotools.adaptation.functions.divide_by_reference:1 of
msgid "Divide every row of ``X`` by a reference spectrum."
msgstr "``X`` の各行を参照スペクトルで除算します。"

#: chemotools.adaptation.functions.divide_by_reference:3 of
msgid ""
"Useful for single-beam transmission corrections or ratiometric "
"normalisation where each sample is divided by a simultaneously measured "
"reference channel."
msgstr "各サンプルを同時測定した参照チャンネルで除算する、シングルビーム透過補正や比率正規化に役立ちます。"

#: chemotools.adaptation.functions.divide_by_reference of
msgid "Parameters"
msgstr "パラメータ"

#: chemotools.adaptation.functions.divide_by_reference:7 of
msgid "Input spectra."
msgstr "入力スペクトル。"

#: chemotools.adaptation.functions.divide_by_reference:9 of
msgid ""
"Reference to divide by.  Accepted shapes:  * scalar ``float`` — divides "
"every element. * ``(1, n_features)`` — shared reference broadcast across "
"all samples. * ``(n_samples, 1)`` — per-sample scalar divisor. * "
"``(n_samples, n_features)`` — per-sample full spectrum.  1-D inputs are "
"rejected; use ``.reshape(1, -1)`` for a shared spectrum or ``.reshape(-1,"
" 1)`` for a per-sample scalar.  Zero values will produce ``inf`` or "
"``nan`` in the output."
msgstr "除数となる参照値。指定可能な形状: * スカラー ``float`` — すべての要素を除算。* ``(1, n_features)`` — 全サンプルにブロードキャストする共通参照値。* ``(n_samples, 1)`` — サンプル別のスカラー除数。* ``(n_samples, n_features)`` — サンプル別の完全なスペクトル。1 次元入力は受け付けません。共通スペクトルには ``.reshape(1, -1)``、サンプル別スカラーには ``.reshape(-1, 1)`` を使用してください。ゼロ値があると出力に ``inf`` または ``nan`` が生じます。"

#: chemotools.adaptation.functions.divide_by_reference:9 of
msgid "Reference to divide by.  Accepted shapes:"
msgstr "除数となる参照値。指定可能な形状:"

#: chemotools.adaptation.functions.divide_by_reference:11 of
msgid "scalar ``float`` — divides every element."
msgstr "スカラー ``float`` — すべての要素を除算します。"

#: chemotools.adaptation.functions.divide_by_reference:12 of
msgid "``(1, n_features)`` — shared reference broadcast across all samples."
msgstr "``(1, n_features)`` — 全サンプルにブロードキャストする共通参照値。"

#: chemotools.adaptation.functions.divide_by_reference:13 of
msgid "``(n_samples, 1)`` — per-sample scalar divisor."
msgstr "``(n_samples, 1)`` — サンプル別のスカラー除数。"

#: chemotools.adaptation.functions.divide_by_reference:14 of
msgid "``(n_samples, n_features)`` — per-sample full spectrum."
msgstr "``(n_samples, n_features)`` — サンプル別の完全なスペクトル。"

#: chemotools.adaptation.functions.divide_by_reference:16 of
msgid ""
"1-D inputs are rejected; use ``.reshape(1, -1)`` for a shared spectrum or"
" ``.reshape(-1, 1)`` for a per-sample scalar.  Zero values will produce "
"``inf`` or ``nan`` in the output."
msgstr "1 次元入力は受け付けません。共通スペクトルには ``.reshape(1, -1)``、サンプル別スカラーには ``.reshape(-1, 1)`` を使用してください。ゼロ値があると出力に ``inf`` または ``nan`` が生じます。"

#: chemotools.adaptation.functions.divide_by_reference of
msgid "Returns"
msgstr "戻り値"

#: chemotools.adaptation.functions.divide_by_reference:21 of
msgid "**X_corrected** -- ``X / reference``."
msgstr "**X_corrected** -- ``X / reference``。"

#: chemotools.adaptation.functions.divide_by_reference of
msgid "Return type"
msgstr "戻り値の型"

#: chemotools.adaptation.functions.divide_by_reference:25 of
msgid "Examples"
msgstr "使用例"

