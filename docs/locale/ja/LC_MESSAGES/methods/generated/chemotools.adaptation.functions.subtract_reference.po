#: ../../source/methods/generated/chemotools.adaptation.functions.subtract_reference.rst:2
msgid "chemotools.adaptation.functions.subtract\\_reference"
msgstr "chemotools.adaptation.functions.subtract\\_reference"

#: chemotools.adaptation.functions.subtract_reference:1 of
msgid "Subtract a reference spectrum from every row of ``X``."
msgstr "``X`` の各行から参照スペクトルを減算します。"

#: chemotools.adaptation.functions.subtract_reference:3 of
msgid ""
"A common operation in spectroscopy for blank or solvent subtraction, "
"background removal, or single-beam to double-beam correction."
msgstr "ブランクまたは溶媒の減算、バックグラウンド除去、シングルビームからダブルビームへの補正に用いられる、分光法で一般的な処理です。"

#: chemotools.adaptation.functions.subtract_reference of
msgid "Parameters"
msgstr "パラメータ"

#: chemotools.adaptation.functions.subtract_reference:6 of
msgid "Input spectra."
msgstr "入力スペクトル。"

#: chemotools.adaptation.functions.subtract_reference:8 of
msgid ""
"Reference to subtract.  Accepted shapes:  * scalar ``float`` — subtracted"
" from every element. * ``(1, n_features)`` — shared reference broadcast "
"across all samples. * ``(n_samples, 1)`` — per-sample scalar subtracted "
"from every feature. * ``(n_samples, n_features)`` — per-sample full "
"spectrum.  1-D inputs are rejected; use ``.reshape(1, -1)`` for a shared "
"spectrum or ``.reshape(-1, 1)`` for a per-sample scalar."
msgstr "減算する参照値。指定可能な形状: * スカラー ``float`` — すべての要素から減算。* ``(1, n_features)`` — 全サンプルにブロードキャストする共通参照値。* ``(n_samples, 1)`` — 各特徴量から減算するサンプル別スカラー。* ``(n_samples, n_features)`` — サンプル別の完全なスペクトル。1 次元入力は受け付けません。共通スペクトルには ``.reshape(1, -1)``、サンプル別スカラーには ``.reshape(-1, 1)`` を使用してください。"

#: chemotools.adaptation.functions.subtract_reference:8 of
msgid "Reference to subtract.  Accepted shapes:"
msgstr "減算する参照値。指定可能な形状:"

#: chemotools.adaptation.functions.subtract_reference:10 of
msgid "scalar ``float`` — subtracted from every element."
msgstr "スカラー ``float`` — すべての要素から減算します。"

#: chemotools.adaptation.functions.subtract_reference:11 of
msgid "``(1, n_features)`` — shared reference broadcast across all samples."
msgstr "``(1, n_features)`` — 全サンプルにブロードキャストする共通参照値。"

#: chemotools.adaptation.functions.subtract_reference:12 of
msgid "``(n_samples, 1)`` — per-sample scalar subtracted from every feature."
msgstr "``(n_samples, 1)`` — 各特徴量から減算するサンプル別スカラー。"

#: chemotools.adaptation.functions.subtract_reference:13 of
msgid "``(n_samples, n_features)`` — per-sample full spectrum."
msgstr "``(n_samples, n_features)`` — サンプル別の完全なスペクトル。"

#: chemotools.adaptation.functions.subtract_reference:15 of
msgid ""
"1-D inputs are rejected; use ``.reshape(1, -1)`` for a shared spectrum or"
" ``.reshape(-1, 1)`` for a per-sample scalar."
msgstr "1 次元入力は受け付けません。共通スペクトルには ``.reshape(1, -1)``、サンプル別スカラーには ``.reshape(-1, 1)`` を使用してください。"

#: chemotools.adaptation.functions.subtract_reference of
msgid "Returns"
msgstr "戻り値"

#: chemotools.adaptation.functions.subtract_reference:19 of
msgid "**X_corrected** -- ``X - reference``."
msgstr "**X_corrected** -- ``X - reference``。"

#: chemotools.adaptation.functions.subtract_reference of
msgid "Return type"
msgstr "戻り値の型"

#: chemotools.adaptation.functions.subtract_reference:23 of
msgid "Examples"
msgstr "使用例"

