msgid "References"
msgstr "参考文献"

#: chemotools.adaptation._direct_standardization.DirectStandardization:33 of
msgid ""
"Wang, Yongdong., Veltkamp, D. J., & Kowalski, B. R. (1991), Multivariate "
"instrument standardization, Analytical Chemistry, 63(23), Pages "
"2750–2756, https://doi.org/10.1021/ac00023a016."
msgstr "Wang, Yongdong., Veltkamp, D. J., & Kowalski, B. R. (1991), 多変量装置標準化, Analytical Chemistry, 63(23), 2750–2756 ページ, https://doi.org/10.1021/ac00023a016."

#: chemotools.adaptation._direct_standardization.DirectStandardization:39 of
msgid "Examples"
msgstr "使用例"

#: chemotools.adaptation._direct_standardization.DirectStandardization:40 of
msgid ""
"**Basic usage** >>> import numpy as np >>> from chemotools.adaptation "
"import DirectStandardization >>> >>> rng = np.random.default_rng(17) >>> "
"X_source = rng.normal(size=(100, 20)) >>> X_target = X_source * 2 - "
"rng.normal(size=(100, 20)) * 0.02 >>> >>> ds = "
"DirectStandardization().fit(X_target, X_source=X_source) >>> X_transf = "
"ds.transform(X_target)"
msgstr "**基本的な使用方法** >>> import numpy as np >>> from chemotools.adaptation import DirectStandardization >>> >>> rng = np.random.default_rng(17) >>> X_source = rng.normal(size=(100, 20)) >>> X_target = X_source * 2 - rng.normal(size=(100, 20)) * 0.02 >>> >>> ds = DirectStandardization().fit(X_target, X_source=X_source) >>> X_transf = ds.transform(X_target)"

